# Dockerfile.agent — base image for an agent's "personal computer".
#
# One image, many containers (one per Agent slug). Containers are long-lived
# (sleep infinity); the orchestrator runs the actual per-session commands
# via `docker exec`. Image layout mirrors the khidr host so that paths like
# /home/khidr/.pyenv/versions/<venv>/bin/python and ~/workspace/<project>
# resolve identically inside and outside the container.
#
# Build:
#   docker build -t khidr-agent:latest -f docker/Dockerfile.agent docker/
# Run (one-shot example):
#   docker run -d --name khidr-agent-foo \
#     --network khidr-agents --restart=unless-stopped \
#     --add-host=khidr:host-gateway \
#     -v /home/khidr/workspace-agents/foo:/home/khidr/workspace \
#     -v /home/khidr/.ssh:/home/khidr/.ssh:ro \
#     -v /home/khidr/workspace/khidr:/home/khidr/workspace/khidr:ro \
#     khidr-agent:latest

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    TZ=UTC \
    KHIDR_IN_CONTAINER=1

# --- System packages -------------------------------------------------------
# Python build deps (for pyenv), git, openssh-client (for agent's `ssh`),
# dumb-init (proper PID 1 signal handling), sudo (agent can use it like the
# host user does), locales (utf-8), ca-certificates, curl.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
      libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev \
      libffi-dev liblzma-dev \
      curl git ca-certificates openssh-client \
      dumb-init sudo locales tzdata \
      postgresql-client libpq-dev python3-dev \
      parallel \
    && locale-gen en_US.UTF-8 \
    && ln -fs /usr/share/zoneinfo/${TZ} /etc/localtime \
    && rm -rf /var/lib/apt/lists/*

# --- Node 22 (matches /usr/bin/node v22 on khidr) --------------------------
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

# --- uvx (for MCP server packages like minimax-coding-plan-mcp) ------------
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/khidr/.local/bin:$PATH"

# --- User parity with host khidr (uid=1000) --------------------------------
# ubuntu:24.04 ships a user `ubuntu` at uid 1000. Remove it, recreate as khidr
# so that bind-mounts from the host (owned by khidr:khidr 1000:1000) have
# matching ownership inside the container.
RUN userdel -r ubuntu 2>/dev/null || true && \
    groupadd -g 1000 khidr && \
    useradd -m -u 1000 -g 1000 -s /bin/bash khidr && \
    echo 'khidr ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/khidr && \
    chmod 0440 /etc/sudoers.d/khidr

USER khidr
WORKDIR /home/khidr

# --- pyenv — same layout as host khidr -------------------------------------
RUN curl https://pyenv.run | bash
ENV PYENV_ROOT=/home/khidr/.pyenv \
    PATH=/home/khidr/.pyenv/bin:/home/khidr/.pyenv/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Login-shell init (for interactive `docker exec -it … bash`)
RUN { \
      echo 'export PYENV_ROOT="$HOME/.pyenv"'; \
      echo 'export PATH="$PYENV_ROOT/bin:$PYENV_ROOT/shims:$PATH"'; \
      echo 'eval "$(pyenv init -)"'; \
      echo 'eval "$(pyenv virtualenv-init -)"'; \
    } >> /home/khidr/.bashrc

# --- Python runtimes -------------------------------------------------------
# 3.14.4 matches the khidr host's primary install (used by khidr
# itself). 3.12.10 covers the Django projects (some need Django 6.0
# which requires >=3.12; most projects stay compatible on 3.12).
# psycopg2-binary 2.9.x ships wheels through 3.13, so 3.12 installs cleanly.
RUN pyenv install 3.14.4 && pyenv install 3.12.10 && pyenv global 3.14.4

# --- Keep pyenv-virtualenv for per-project venv creation -------------------
# The plugin is installed automatically by pyenv.run in recent versions; this
# just confirms the directory is present. The provisioning step creates
# venvs of the form `pyenv virtualenv 3.14.4 <project-slug>`.
RUN test -d /home/khidr/.pyenv/plugins/pyenv-virtualenv

# --- Long-lived keepalive --------------------------------------------------
# dumb-init handles SIGTERM properly; sleep infinity keeps PID 1 alive
# without consuming CPU. `docker exec` attaches sessions; they come and go.
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["sleep", "infinity"]
