# =========================
# Django
# =========================
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# "*" for dev (lets you hit the server from phone/LAN IP without DisallowedHost 400).
# Pin to real hostnames in prod.
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
TIME_ZONE=UTC

# =========================
# PostgreSQL
# =========================
PG_HOST=127.0.0.1
PG_PORT=5432
PG_NAME=khidr
PG_USER=khidr
PG_PASS=

# =========================
# Orchestrator
# =========================
# Web login — bcrypt hash of the password:
#   python -c "from chat.auth import hash_password; print(hash_password('...'))"
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=

# Telegram (one-way: orchestrator → user).
# Fires on ask_user(), set_status("review"), and requeue cap exhaustion.
# Create a bot with @BotFather; CHAT_ID is yours (use @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chat history summarization threshold (tokens)
SUMMARIZE_THRESHOLD=20000

# How long (seconds) before a silent agent is considered stuck
HEARTBEAT_TIMEOUT_SECONDS=1800

# Cooldown between a "finished-without-review" session and the next
# re-dispatch of the same task (seconds)
REQUEUE_COOLDOWN_SECONDS=300

# =========================
# Agents
# =========================
# Sandbox for agents that don't pick one: docker (a fresh container per run) or local.
KHIDR_SANDBOX=docker
KHIDR_SANDBOX_IMAGE=khidr-sandbox:latest
# How sandboxes reach this Khidr (the /mcp/ endpoint). From Docker, localhost
# becomes host.docker.internal automatically.
KHIDR_INTERNAL_URL=http://127.0.0.1:8000
# Git caches, task workspaces, agent homes (CLI logins).
KHIDR_DATA_DIR=
# How long an agent rests after its provider reports a rate/usage limit.
KHIDR_RATE_LIMIT_COOLDOWN_SECONDS=1800
KHIDR_MAX_TURNS=200
# Extra `docker run` flags for sandboxes, e.g. --memory 4g --cpus 2
KHIDR_SANDBOX_DOCKER_ARGS=

# Agent credentials: whatever env vars your agents.yaml names in api_key_env, e.g.
CLAUDE_CODE_OAUTH_TOKEN=
MINIMAX_API_KEY=

# Base URL of this Khidr instance (links in notifications)
CHAT_BASE_URL=http://localhost:8000

# Secret path segment for /webhooks/uptime-kuma/<token>/
KHIDR_API_TOKEN=

# =========================
# GlitchTip (optional)
# =========================
GLITCHTIP_URL=
GLITCHTIP_API_KEY=

# =========================
# Sentry (errors of Khidr itself, optional)
# =========================
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
